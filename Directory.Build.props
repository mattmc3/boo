<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Assembly attributes are hand-written in each project's AssemblyInfo. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Strong naming is gone: .NET does not verify it and this fork owes no
         assembly-identity compatibility. IGNOREKEYFILE drops the AssemblyKeyFile
         attributes still present in the AssemblyInfo sources. -->
    <SignAssembly>false</SignAssembly>
    <DefineConstants>$(DefineConstants);IGNOREKEYFILE</DefineConstants>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>The Boo Programming Language</Company>
    <Copyright>Copyright (c) 2003-2026 Rodrigo B. de Oliveira and contributors</Copyright>

    <!-- CA2200 fires 322 times on pre-existing rethrow patterns; SYSLIB0050/0051
         on the [Serializable] surface that outlived BinaryFormatter. Both are
         cleanup, not port work. -->
    <NoWarn>$(NoWarn);CA2200;SYSLIB0050;SYSLIB0051;CS8981</NoWarn>
  </PropertyGroup>

</Project>
