<Project>

  <!--
    Builds .boo sources with the stage-1 booc produced from the C# core.
    Replaces CoreCompile so that references, output paths and project
    ordering keep coming from the .NET SDK.
  -->

  <PropertyGroup>
    <DefaultLanguageSourceExtension>.boo</DefaultLanguageSourceExtension>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <BoocDll Condition="'$(BoocDll)' == ''">$(MSBuildThisFileDirectory)src/booc/bin/$(Configuration)/$(TargetFramework)/booc.dll</BoocDll>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableDefaultBooItems)' != 'false'">
    <BooCompile Include="**/*.boo" Exclude="$(BaseOutputPath)/**;$(BaseIntermediateOutputPath)/**;bin/**;obj/**" />
  </ItemGroup>

  <Target Name="BoocTarget" DependsOnTargets="$(CoreCompileDependsOn)">
    <PropertyGroup>
      <_BooTargetKind Condition="'$(OutputType)' == 'Exe'">exe</_BooTargetKind>
      <_BooTargetKind Condition="'$(OutputType)' == 'WinExe'">winexe</_BooTargetKind>
      <_BooTargetKind Condition="'$(_BooTargetKind)' == ''">library</_BooTargetKind>
      <_BooOutput>$(ProjectDir)$(IntermediateOutputPath)$(TargetFileName)</_BooOutput>
    </PropertyGroup>

    <Error Condition="!Exists('$(BoocDll)')"
           Text="booc was not found at $(BoocDll). Build src/booc first." />

    <!--
      booc loads the framework itself from the running runtime's trusted
      platform assemblies, so the SDK's reference pack must not be passed:
      the ref assemblies would collide with the implementation ones.
    -->
    <ItemGroup>
      <_BooReference Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' == ''" />
    </ItemGroup>

    <MakeDir Directories="$(ProjectDir)$(IntermediateOutputPath)" />

    <Exec Command="dotnet &quot;$(BoocDll)&quot; -noconfig -target:$(_BooTargetKind) -out:&quot;$(_BooOutput)&quot; @(_BooReference->'-r:&quot;%(FullPath)&quot;', ' ') @(BooCompile->'&quot;%(FullPath)&quot;', ' ')"
          StandardOutputImportance="normal" />

    <ItemGroup>
      <FileWrites Include="$(_BooOutput)" />
    </ItemGroup>
  </Target>

  <!-- Normally supplied by Microsoft.CSharp.targets; nothing to name here. -->
  <Target Name="CreateManifestResourceNames" />

  <!-- CoreCompile is what the SDK calls; point it at booc. -->
  <Target Name="CoreCompile" DependsOnTargets="BoocTarget"
          Inputs="@(BooCompile);@(ReferencePath)"
          Outputs="$(ProjectDir)$(IntermediateOutputPath)$(TargetFileName)" />

</Project>
