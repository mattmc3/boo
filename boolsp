#!/bin/sh
# Runs the boolsp built from source. Set BOO_CONFIGURATION=Release for that build.
config=${BOO_CONFIGURATION:-Debug}
root=$(dirname "$0")
exe="$root/src/boolsp/bin/$config/net10.0/boolsp"
if [ ! -x "$exe" ]; then
	echo "boolsp is not built. Run: dotnet build Boo.slnx" >&2
	exit 1
fi
exec "$exe" "$@"
