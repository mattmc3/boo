			<LITERAL2>self</LITERAL2>
			<LITERAL2>super</LITERAL2>
		</KEYWORDS>
	</RULES>

	<RULES SET="string" DEFAULT="LITERAL1">
		<SPAN TYPE="LITERAL3">
			<BEGIN>${</BEGIN>
			<END>}</END>
		</SPAN>
	</RULES>
</MODE>
