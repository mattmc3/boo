<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Nih.Tests</AssemblyName>
    <RootNamespace>Nih.Tests</RootNamespace>

    <!-- The example states its own attributes in Properties/AssemblyInfo. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- examples/ sits outside tests/Directory.Build.props, so this project
         names the test packages itself. -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Nih/Nih.csproj" />
    <ProjectReference Include="../../../../../src/Boo.Lang/Boo.Lang.csproj" />
    <ProjectReference Include="../../../../../src/Boo.Lang.Compiler/Boo.Lang.Compiler.csproj" />
  </ItemGroup>

</Project>
